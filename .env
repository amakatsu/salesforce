# API設定ファイル
# 環境に合わせて値を設定してください

# ===== Azure OpenAI のヘッダー設定（JSON形式）=====
# word.py と PR-Agent の両方でこの設定を使用
# api-key と apim-user-id を設定
OPENAI_HEADERS_JSON={"api-key":"8b843f2df20548899f93c0624452ea68","apim-user-id":"PIT03077"}

# ===== PR-Agent 設定 =====
# GitLab API Token (MRアクセス用)
GITLAB_TOKEN=your_gitlab_token_here

# PR-Agent設定 (オプション)
# PR_AGENT_CONFIG=security-focused  # デフォルト設定ファイル名

# ===== word.py 設定 =====
# OpenAI互換API設定（Azure OpenAI使用時）
OPENAI_BASE_URL=https://mufg-openai-api.azure-api.net/aoai001/openai/deployments/ptu
OPENAI_MODEL=gpt-4o-mini
OPENAI_PATH=/chat/completions

# 認証方式
OPENAI_SEND_AUTH=false

# プロキシ設定 (必要に応じて)
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=https://proxy.example.com:8080
# VERIFY_SSL=true

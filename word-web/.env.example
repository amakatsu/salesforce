# OpenAI API設定
OPENAI_BASE_URL=https://mufg-openai-api.azure-api.net/aoai001/openai/deployments/ptu
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_PATH=/chat/completions
OPENAI_HEADERS_JSON={"api-key":"your-key","apim-user-id":"YOUR_ID"}
OPENAI_SEND_AUTH=false
OPENAI_ORG_ID=

# プロキシ設定（必要な場合のみ）
HTTP_PROXY=
HTTPS_PROXY=
VERIFY_SSL=true

# 生成パラメタ
MAX_TOKENS=800
TEMPERATURE=0.7
TOP_P=0.95
PRESENCE_PENALTY=0.0
FREQUENCY_PENALTY=0.0

# 類似度設定
FUZZY_THRESHOLD=0.72
TOP_K=3

# 実行制御
TIMEOUT_SEC=30
MAX_WORKERS=6
MAX_CONCURRENT_API=5
RETRY=30

# Excel設定
SCREEN_GLOB=*画面項目定義*.xlsx
VOCAB_GLOB=*単語名一覧*.xlsx
SCREEN_SHEET=*
VOCAB_SHEET=*
SCREEN_COL=項目名称
VOCAB_TERM_COL=論理名
VOCAB_PHYS_COL=物理名（正式名称）
VOCAB_PHYS_ABBR_COL=物理名（略称）
VOCAB_NO_COL=No

# ヘッダー検出
HEADER_DETECT=true
HEADER_SCAN_ROWS=10

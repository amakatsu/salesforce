import os
import json
import asyncio
import requests
import openai
from tenacity import retry, retry_if_exception_type, retry_if_not_exception_type, stop_after_attempt

from pr_agent.algo import (
    CLAUDE_EXTENDED_THINKING_MODELS,
    NO_SUPPORT_TEMPERATURE_MODELS,
    SUPPORT_REASONING_EFFORT_MODELS,
    USER_MESSAGE_ONLY_MODELS,
)
from pr_agent.algo.ai_handlers.base_ai_handler import BaseAiHandler
from pr_agent.algo.utils import ReasoningEffort, get_version
from pr_agent.config_loader import get_settings
from pr_agent.log import get_logger

OPENAI_RETRIES = 5


class LiteLLMAIHandler(BaseAiHandler):
    """
    Requests only: send OpenAI-compatible Chat Completions to Azure APIM directly.
    """

    def __init__(self):
        self.azure = False
        self.api_base = None
        self.repetition_penalty = None

        # ====== 既存の設定引き回しは最小限維持（必要に応じて削ってもOK） ======
        if get_settings().get("OPENAI.API_BASE", None):
            self.api_base = get_settings().openai.api_base

        # Azure AD 経由を使っていた場合でも、今回は Authorization は付けない運用にする
        if get_settings().get("AZURE_AD.CLIENT_ID", None):
            # api_base は Azure AD セットの値を優先
            self.api_base = get_settings().azure_ad.api_base

        # OpenRouter/HuggingFace/Ollama等の分岐は無視しても良いが、api_base が設定されていれば尊重
        if get_settings().get("HUGGINGFACE.API_BASE", None) and 'huggingface' in get_settings().config.model:
            self.api_base = get_settings().huggingface.api_base
        if get_settings().get("OLLAMA.API_BASE", None):
            self.api_base = get_settings().ollama.api_base
        if get_settings().get("OPENROUTER.API_BASE", None):
            self.api_base = get_settings().get("OPENROUTER.API_BASE")

        self.user_message_only_models = USER_MESSAGE_ONLY_MODELS
        self.no_support_temperature_models = NO_SUPPORT_TEMPERATURE_MODELS
        self.support_reasoning_models = SUPPORT_REASONING_EFFORT_MODELS
        self.claude_extended_thinking_models = CLAUDE_EXTENDED_THINKING_MODELS

    def prepare_logs(self, response_json, system, user, resp, finish_reason):
        # response_json は dict 前提
        response_log = dict(response_json) if isinstance(response_json, dict) else {"raw": response_json}
        response_log['system'] = system
        response_log['user'] = user
        response_log['output'] = resp
        response_log['finish_reason'] = finish_reason
        response_log['main_pr_language'] = getattr(self, 'main_pr_language', 'unknown')
        return response_log

    @property
    def deployment_id(self):
        return get_settings().get("OPENAI.DEPLOYMENT_ID", None)

    # ====== 同期HTTPをスレッドで呼ぶヘルパ ======
    def _post_chat_sync(self, url: str, headers: dict, payload: dict, timeout_s: int):
        # Authorizationは入れない（入っていたら潰す）
        headers = dict(headers or {})
        headers.pop("Authorization", None)

        resp = requests.post(url, headers=headers, json=payload, timeout=timeout_s)
        if resp.status_code < 200 or resp.status_code >= 300:
            # Azure系は detail を返すことがあるので握りつぶさずに入れる
            try:
                err_json = resp.json()
            except Exception:
                err_json = {"text": resp.text}
            raise openai.APIError(f"Upstream error {resp.status_code}: {err_json}")
        try:
            return resp.json()
        except Exception as e:
            raise openai.APIError(f"Invalid JSON from upstream: {e}")

    def _build_url(self) -> str:
        if not self.api_base:
            raise openai.APIError("api_base is not set")
        dep = self.deployment_id
        if not dep:
            raise openai.APIError("deployment_id is not set (OPENAI.DEPLOYMENT_ID)")
        base = self.api_base.rstrip("/")
        # 期待URL: {api_base}/deployments/{dep}/chat/completions
        return f"{base}/deployments/{dep}/chat/completions"

    def _build_headers(self) -> dict:
        # ★ 固定投入（ご指定の実値）
        headers = {
            "Content-Type": "application/json",
            "api-key": "8b843f2df20548899f93c0624452ea68",
            "apim-user-id": "PIT04447",
        }
        return headers

    def _build_payload(self, messages, temperature, extra_opts: dict) -> dict:
        # OpenAI互換の最低限だけ送る（未対応キーは送らない）
        payload = {
            "messages": messages,
        }
        if temperature is not None:
            payload["temperature"] = float(temperature)

        # max_tokens / top_p / frequency_penalty / presence_penalty だけ安全に拾う
        for key in ("max_tokens", "top_p", "frequency_penalty", "presence_penalty"):
            if key in extra_opts and extra_opts[key] is not None:
                payload[key] = extra_opts[key]

        # 必要なら stop / response_format / tools / tool_choice 等をここでホワイトリスト追加

        return payload

    @retry(
        retry=retry_if_exception_type(openai.APIError) & retry_if_not_exception_type(openai.RateLimitError),
        stop=stop_after_attempt(OPENAI_RETRIES),
    )
    async def chat_completion(self, model: str, system: str, user: str, temperature: float = 0.2, img_path: str = None):
        try:
            if 'claude' in model and not system:
                system = "No system prompt provided"
                get_logger().warning("Empty system prompt for claude model; injecting placeholder.")

            messages = [{"role": "system", "content": system}, {"role": "user", "content": user}]

            # 画像URLが来たときの生存チェック（従来動作を維持）
            if img_path:
                try:
                    r = requests.head(img_path, allow_redirects=True)
                    if r.status_code == 404:
                        error_msg = (
                            f"The image link is not [alive]({img_path}).\n"
                            "Please repost the original image as a comment, and send the question again with 'quote reply'."
                        )
                        get_logger().error(error_msg)
                        return f"{error_msg}", "error"
                except Exception as e:
                    get_logger().error(f"Error fetching image: {img_path} {e}")
                    return f"Error fetching image: {img_path}", "error"
                # Azure/OpenAIのimage_url形式に合わせる
                messages[1]["content"] = [
                    {"type": "text", "text": messages[1]["content"]},
                    {"type": "image_url", "image_url": {"url": img_path}},
                ]

            # user_message_only / reasoning などの従来分岐は維持するが、未対応キーはpayloadに入れない
            extra_opts = {}
            if model not in self.no_support_temperature_models and not get_settings().config.custom_reasoning_model:
                pass  # temperatureはそのまま引数で渡す

            if model in self.support_reasoning_models:
                # reasoning_effort 自体は OpenAI 互換の微妙な差があるので payload には入れない（必要ならここで入れる）
                _ = get_settings().config.reasoning_effort
                get_logger().info(f"reasoning_effort configured: {_} (not sent)")

            if (model in self.claude_extended_thinking_models) and get_settings().config.get("enable_claude_extended_thinking", False):
                # thinking/max_tokens= の特殊パラメータは送らない（Azure互換で齟齬が出やすい）
                get_logger().info("Claude extended thinking requested (not sent in raw payload).")

            # seed は OpenAI 互換で未サポートなことが多いので送らない
            seed = get_settings().config.get("seed", -1)
            if temperature > 0 and seed >= 0:
                raise ValueError(f"Seed ({seed}) is not supported with temperature ({temperature}) > 0")

            if self.repetition_penalty is not None:
                extra_opts["frequency_penalty"] = self.repetition_penalty  # 近い意味の項目に寄せる（あるいは presence_penalty）

            # URL / Headers / Payload 構築
            url = self._build_url()
            headers = self._build_headers()
            timeout_s = int(get_settings().config.ai_timeout or 60)

            # user_only モデルは system と user を結合
            if model in self.user_message_only_models or get_settings().config.custom_reasoning_model:
                user_merged = f"{system}\n\n\n{user}" if system else user
                messages = [{"role": "user", "content": user_merged}]

            payload = self._build_payload(messages, temperature, extra_opts)

            # デバッグ出力（プロンプト）
            get_logger().debug("Prompts", artifact={"system": system, "user": user})
            if get_settings().config.verbosity_level >= 2:
                get_logger().info(f"\nSystem prompt:\n{system}")
                get_logger().info(f"\nUser prompt:\n{user}")

            # 同期HTTPをスレッドで実行
            loop = asyncio.get_running_loop()
            response_json = await loop.run_in_executor(
                None, self._post_chat_sync, url, headers, payload, timeout_s
            )

        except openai.RateLimitError as e:
            get_logger().error(f"Rate limit error during LLM inference: {e}")
            raise
        except openai.APIError as e:
            get_logger().warning(f"Error during LLM inference: {e}")
            raise
        except Exception as e:
            get_logger().warning(f"Unknown error during LLM inference: {e}")
            raise openai.APIError from e

        # 返却フォーマットを OpenAI 互換の expectations に合わせて読む
        if not response_json or "choices" not in response_json or not response_json["choices"]:
            raise openai.APIError("Empty or invalid response from upstream")

        choice0 = response_json["choices"][0]
        # message.content or delta.content（stream しないので message 想定）
        if "message" in choice0 and "content" in choice0["message"]:
            resp_text = choice0["message"]["content"]
        elif "delta" in choice0 and "content" in choice0["delta"]:
            resp_text = choice0["delta"]["content"]
        else:
            raise openai.APIError("Response missing content field")

        finish_reason = choice0.get("finish_reason", "stop")
        get_logger().debug(f"\nAI response:\n{resp_text}")

        # フルレスポンスもログ
        response_log = self.prepare_logs(response_json, system, user, resp_text, finish_reason)
        get_logger().debug("Full_response", artifact=response_log)

        if get_settings().config.verbosity_level >= 2:
            get_logger().info(f"\nAI response:\n{resp_text}")

        return resp_text, finish_reason
